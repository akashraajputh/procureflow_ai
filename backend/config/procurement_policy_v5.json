{
  "document": "CORVO-PROC-POL-04",
  "version": "5.0",
  "effective_date": "2026-04-01",
  "owner": "Head of Procurement",
  "plants": ["PUN1", "CHK1"],
  "limits": {
    "emergency_po_threshold": 500000,
    "spot_po_threshold": 200000,
    "rfq_threshold": 1000000,
    "rfp_threshold": 1000000
  },
  "history_windows": {
    "preferred_supplier_days": 548,
    "recent_purchase_days": 365
  },
  "rule_priority": [
    {"id": "new_item", "when": {"field": "item_missing", "operator": "eq", "value": true}, "decision": "SOURCING_REQUEST", "route": "NEW_ITEM_SOURCING", "clause": "1.2", "supplier": "none"},
    {"id": "capex", "when": {"field": "item_type", "operator": "eq", "value": "capex"}, "decision": "SOURCING_REQUEST", "route": "CAPEX_SOURCING", "clause": "5.1", "supplier": "suggest_5"},
    {"id": "contract", "when": {"field": "contract_available", "operator": "eq", "value": true}, "decision": "PO", "route": "CONTRACT_PO", "clause": "5.2", "supplier": "contract_supplier"},
    {"id": "emergency", "when": {"all": [{"field": "emergency", "operator": "eq", "value": true}, {"field": "value", "operator": "lte", "value": {"limit": "emergency_po_threshold"}}, {"field": "has_recent_active_supplier", "operator": "eq", "value": true}]}, "decision": "PO", "route": "EMERGENCY_PO", "clause": "5.3", "supplier": "first_preferred_supplier"},
    {"id": "spot", "when": {"all": [{"field": "value", "operator": "lt", "value": {"limit": "spot_po_threshold"}}, {"field": "has_recent_active_supplier", "operator": "eq", "value": true}]}, "decision": "PO", "route": "SPOT_PO", "clause": "5.4", "supplier": "first_preferred_supplier"},
    {"id": "rfq", "when": {"field": "value", "operator": "lt", "value": {"limit": "rfq_threshold"}}, "decision": "SOURCING_REQUEST", "route": "RFQ", "clause": "5.5", "supplier": "suggest_3"},
    {"id": "rfp", "when": {"field": "value", "operator": "gte", "value": {"limit": "rfp_threshold"}}, "decision": "SOURCING_REQUEST", "route": "RFP", "clause": "5.6", "supplier": "suggest_5"}
  ]
}
